# Copy this file to .env and fill in your key, then restart: npm run server
ANTHROPIC_API_KEY=sk-ant-...
# Optional – defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Creator mode – fal.ai for image generation
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=...

# Creator mode – ElevenLabs for voice narration
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
# Optional – a specific voice id. Defaults to "21m00Tcm4TlvDq8ikWAM" (Rachel)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
